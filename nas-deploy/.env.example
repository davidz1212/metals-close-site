# ===== 贵金属日报站点 · NAS 生产环境模板 =====
# 用法：把本文件复制为 .env 后填写。飞牛 Compose 会从项目目录自动读取 .env。
# 所有密钥只在服务端使用，不会下发到浏览器。

# ---------- 基础（一般不用改）----------
PORT=8765
SITE_BASE_URL=http://192.168.1.99:8790
MC_DB_PATH=/app/data/site.db

# SECRET_KEY：会话签名密钥，已为你生成一串随机值；如需更换可用任意长随机串。
# 警告：更换后所有已登录会话立即失效，需要重新收验证码登录。
SECRET_KEY=AUmjfF6SbGBWGZVRILgdu52R2aInU-YUZLmzWSjiBp7CEEoFajxnoHmd_dSOKqcF

# ---------- 首次订阅邮箱（重要）----------
# 填你自己的邮箱：只有这个邮箱能申请验证码并查询数据。
# 只在首次启动写入一次数据库；以后增减邮箱请用命令行工具，见操作手册。
INITIAL_SUBSCRIBER=you@example.com

# ---------- 登录安全（生产必须如下）----------
# 内网 HTTP 访问时 COOKIE_SECURE 必须为 0，否则浏览器不会回传 Cookie，登不进去。
# 只有当你给站点配了 HTTPS 并对外发布时，才改成 1。
MC_DEV_MODE=0
MC_COOKIE_SECURE=0
MC_SESSION_TTL_HOURS=24
MC_CODE_TTL_SECONDS=600
MC_CODE_MAX_ATTEMPTS=5
MC_CODE_COOLDOWN_SECONDS=60

# ---------- Resend（登录验证码邮件，生产必填）----------
# 不填则验证码发不出去，任何人都无法登录（见前端"暂未开放"状态）。
# RESEND_FROM_EMAIL 必须是 Resend 里已验证的域名邮箱。
RESEND_API_KEY=
RESEND_FROM_EMAIL=Metals Close <onboarding@yourdomain.com>

# ---------- Paddle（订阅支付，后续配置）----------
# 未配置时前端显示"暂未开放订阅"，不影响已有订阅邮箱登录查询。
PADDLE_ENV=sandbox
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_PRICE_ID_CNY=
PADDLE_PRICE_ID_USD=
PADDLE_WEBHOOK_SECRET=

# ---------- 价格展示 ----------
MC_PRICE_CNY=99
MC_PRICE_USD=14
