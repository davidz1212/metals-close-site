# 复制本文件为 .env 后填写。所有密钥只在服务端使用，不会下发到浏览器。

# ---------- 基础 ----------
PORT=8765
SITE_BASE_URL=http://127.0.0.1:8765
SECRET_KEY=请改成一串随机长字符串
MC_DB_PATH=

# ---------- 本地开发 / 内网开放 / 自动更新 ----------
# 仅本地预览时设为 1：验证码直接随接口返回，不发邮件。公网生产必须设为 0。
MC_DEV_MODE=0
# 设为 1 时免登录/免订阅直接开放查看（适合内网测试或个人自用）；上线订阅墙时改为 0。
MC_PUBLIC_ACCESS=0
# 容器内后台每日定时自动采集并入库（1=开启，0=关闭）
MC_AUTO_UPDATE=1
# 自动采集时间（北京时间 HH:MM，逗号分隔）
MC_AUTO_UPDATE_TIMES=07:30,17:30
MC_COOKIE_SECURE=0
MC_SESSION_TTL_HOURS=24
MC_CODE_TTL_SECONDS=600
MC_CODE_MAX_ATTEMPTS=5
MC_CODE_COOLDOWN_SECONDS=60

# ---------- Resend（登录验证码邮件） ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Metals Close <onboarding@yourdomain.com>

# ---------- Paddle（订阅结账，后续配置） ----------
PADDLE_ENV=sandbox
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_PRICE_ID_CNY=
PADDLE_PRICE_ID_USD=
PADDLE_WEBHOOK_SECRET=

# ---------- 价格展示 ----------
MC_PRICE_CNY=99
MC_PRICE_USD=14
